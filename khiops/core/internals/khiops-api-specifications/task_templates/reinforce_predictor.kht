// Dictionary file and class settings
ClassManagement.OpenFile
ClassFileName __dictionaryFilePath__
OK

// Reinforcement settings
TrainDatabase.ClassName __predictorDictionaryName__

// Reinforce model
LearningTools.ReinforcePredictor
